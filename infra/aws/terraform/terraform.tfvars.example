aws_region   = "us-east-1"
app_name     = "recruiterreply"
environment  = "development"

availability_zones = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.101.0/24", "10.30.102.0/24"]

# Ubuntu 24.04 LTS (x86_64) for us-east-1; replace if needed.
ami_id        = "ami-04b4f1a9cf54c11d0"
instance_type = "t3.small"

allowed_ssh_cidrs = ["203.0.113.10/32"]

enable_rds         = true
db_instance_class  = "db.t4g.micro"
db_name            = "recruiterreply"
db_username        = "recruiterreply_admin"
db_skip_final_snapshot = true

create_frontend_buckets = true
frontend_bucket_names = {
  dev  = "recruiterreply-dev-frontend-youruniqueid"
  test = "recruiterreply-test-frontend-youruniqueid"
  prod = "recruiterreply-prod-frontend-youruniqueid"
}

tags = {
  Owner = "platform"
}
